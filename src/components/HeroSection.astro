---
import { siteData } from '../data/site';
---

<section class="py-20 md:py-32 flex flex-col md:flex-row items-center justify-between gap-12">
  <div class="flex-1 space-y-6">
    <h1 class="hero-title font-headings text-primary animate-fade-in">
      {siteData.name}
    </h1>
    <p class="text-xl md:text-2xl text-muted max-w-2xl font-body leading-relaxed">
      {siteData.tagline}. {siteData.bio}
    </p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a href="/projects" class="px-8 py-3 bg-primary text-primary-foreground rounded-full font-medium hover:opacity-90 transition-opacity">
        View My Work
      </a>
      <a href="/contact" class="px-8 py-3 border border-primary text-primary rounded-full font-medium hover:bg-primary/5 transition-colors">
        Let's Talk
      </a>
    </div>
  </div>

  <div class="flex-1 flex justify-center md:justify-end">
    <div class="relative w-64 h-64 md:w-80 md:h-80">
      <!-- Stylized animated background shape -->
      <div class="absolute inset-0 bg-primary/20 rounded-full blur-3xl animate-pulse"></div>
      <svg class="relative w-full h-full text-primary" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M44.7,-76.4C58.1,-69.2,69.2,-58.1,76.4,-44.7C83.6,-31.3,86.9,-15.7,85.2,-0.9C83.6,13.8,77.1,27.7,68.4,39.7C59.7,51.7,48.8,61.8,36.2,68.8C23.6,75.8,9.3,79.7,-5.4,89C-20,98.3,-34.9,113,-47.9,112.1C-60.9,111.1,-71.9,94.5,-79.1,79.3C-86.4,64.1,-89.9,50.3,-92.4,36.5C-94.9,22.7,-96.4,8.8,-94.3,-4.8C-92.2,-18.4,-86.5,-31.6,-78.2,-43.3C-69.8,-55,-58.7,-65.3,-46.1,-72.9C-33.5,-80.5,-19.4,-85.4,-2.5,-81.1C14.5,-76.8,28.9,-63.3,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
