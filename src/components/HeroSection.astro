---
import { ChevronDown } from 'lucide-react';
---

<section class="relative min-h-[calc(100vh-80px)] flex flex-col items-center justify-center overflow-hidden py-20">
  <!-- Animated Background Orbs -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-mint/10 rounded-full blur-[120px] animate-float"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-indigo-accent/5 rounded-full blur-[140px] animate-float" style="animation-delay: -3s;"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="inline-block mb-6 py-1 px-4 glass rounded-full">
      <p class="font-mono text-xs md:text-sm font-bold text-mint tracking-widest">
        // INFORMATION SECURITY ANALYST
      </p>
    </div>

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black text-slate-50 tracking-tight mb-6">
      Mohamed <span class="text-transparent bg-clip-text bg-gradient-to-r from-mint to-indigo-accent">Ismail</span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-slate-400 mb-10 leading-relaxed">
      Specializing in threat detection, SIEM engineering, and security operations. 
      Turning raw logs into actionable intelligence and building resilient digital defenses.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="/projects" 
        class="group relative px-8 py-4 bg-mint text-slate-950 font-bold rounded-xl transition-all hover:brightness-110 hover:shadow-[0_0_20px_rgba(90,214,168,0.4)]"
      >
        View My Work
        <span class="absolute inset-0 bg-white/20 rounded-xl scale-0 group-hover:scale-100 transition-transform duration-500"></span>
      </a>
      <a 
        href="/contact" 
        class="px-8 py-4 glass text-mint font-bold rounded-xl border border-mint/30 hover:bg-mint/10 transition-all"
      >
        Contact Me
      </a>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-50">
    <ChevronDown size={32} class="text-mint" />
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(20px, -40px); }
  }
</style>
