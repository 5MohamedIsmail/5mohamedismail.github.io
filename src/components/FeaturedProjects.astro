---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const featuredProjects = (await getCollection('projects'))
  .filter(project => project.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="py-24">
  <div class="container mx-auto px-6">
    <SectionHeading label="// CASE STUDIES" title="Featured Work" />
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredProjects.map((project) => (
        <ProjectCard 
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          slug={project.slug}
          featured={project.data.featured}
        />
      ))}
    </div>

    <div class="mt-16 text-center">
      <a 
        href="/projects" 
        class="inline-flex items-center gap-2 font-mono text-sm font-bold text-mint hover:underline transition-all"
      >
        VIEW_ALL_PROJECTS.exe <span class="animate-pulse">_</span>
      </a>
    </div>
  </div>
</section>
