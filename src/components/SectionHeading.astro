---
interface Props {
  label: string;
  title: string;
  centered?: boolean;
}

const { label, title, centered = false } = Astro.props;
---

<div class:list={["mb-12", centered ? "text-center" : "text-left"]}>
  <p class="font-mono text-xs font-bold text-mint uppercase tracking-[0.2em] mb-3">
    {label}
  </p>
  <h2 class="text-3xl md:text-4xl font-bold text-slate-50 relative inline-block">
    {title}
    <span class="absolute -bottom-2 left-0 w-1/2 h-1 bg-gradient-to-r from-mint to-transparent rounded-full"></span>
  </h2>
</div>
