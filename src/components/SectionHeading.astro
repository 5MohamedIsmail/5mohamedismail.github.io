---
interface Props {
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { title, subtitle, centered = false } = Astro.props;
---

<div class={`mb-12 ${centered ? 'text-center' : ''}`}>
  <h2 class="text-4xl md:text-5xl font-headings text-primary mb-4 tracking-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="text-muted text-lg max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
  <div class={`h-1 w-20 bg-primary/20 mt-4 ${centered ? 'mx-auto' : ''}`}></div>
</div>
