---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={[
  "inline-flex items-center px-3 py-1 text-xs font-mono font-medium text-mint bg-mint/5 border border-mint/20 rounded-full transition-all hover:bg-mint/10 hover:border-mint/40",
  className
]}>
  <slot />
</span>
