---
import { siteData } from '../data/site';
const currentYear = new Date().getFullYear();
---

<footer class="py-12 border-t border-border mt-20">
  <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center">
    <div class="mb-4 md:mb-0">
      <p class="text-sm text-muted">
        © {currentYear} {siteData.name}. All rights reserved.
      </p>
    </div>
    
    <div class="flex space-x-6">
      {Object.entries(siteData.social).map(([platform, url]) => (
        <a href={url} class="text-sm text-muted hover:text-primary capitalize" target="_blank" rel="noopener noreferrer">
          {platform}
        </a>
      ))}
    </div>
  </div>
</footer>
