---
import { Github, Linkedin, Twitter, Mail } from 'lucide-react';

const currentYear = new Date().getFullYear();

const socials = [
  { icon: Github, href: 'https://github.com/5mohamedismail', label: 'GitHub' },
  { icon: Linkedin, href: 'https://linkedin.com/in/5mohamedismail', label: 'LinkedIn' },
  { icon: Twitter, href: 'https://twitter.com/5mohamedismail', label: 'Twitter' },
  { icon: Mail, href: 'mailto:contact@mohamedismail.com', label: 'Email' },
];
---

<footer class="mt-auto border-t border-white/5 bg-slate-900/30 py-12">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="flex flex-col items-center md:items-start gap-2">
        <a href="/" class="font-mono text-lg font-bold text-slate-50 tracking-tighter">
          <span class="text-mint">MI</span> portfolio
        </a>
        <p class="text-slate-500 text-sm">
          &copy; {currentYear} Mohamed Ismail. All rights reserved.
        </p>
      </div>

      <div class="flex items-center gap-6">
        {socials.map((social) => (
          <a 
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-mint transition-all hover:scale-110"
            aria-label={social.label}
          >
            <social.icon size={20} />
          </a>
        ))}
      </div>
      
      <p class="text-xs font-mono text-slate-600">
        // SECURED WITH AES-256-GCM
      </p>
    </div>
  </div>
</footer>
