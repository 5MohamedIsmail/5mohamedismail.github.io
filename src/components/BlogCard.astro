---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
}

const { title, description, pubDate, tags, href } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="py-8 border-b border-border last:border-0 group">
  <div class="flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8">
    <time class="text-sm text-muted font-medium min-w-[140px]">
      {formattedDate}
    </time>
    
    <div class="flex-grow">
      <h3 class="text-2xl font-headings mb-2 group-hover:text-primary transition-colors">
        <a href={href}>{title}</a>
      </h3>
      <p class="text-muted text-sm mb-4 leading-relaxed max-w-3xl">
        {description}
      </p>
      
      <div class="flex flex-wrap gap-2">
        {tags.map(tag => (
          <span class="text-xs text-primary/70 font-medium">
            #{tag}
          </span>
        ))}
      </div>
    </div>
  </div>
</article>
