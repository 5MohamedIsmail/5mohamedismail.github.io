---
import { Menu, X } from 'lucide-react';

const navLinks = [
  { name: 'Projects', href: '/projects' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-slate-950/60 backdrop-blur-xl border-b border-white/5">
  <div class="container mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="group flex items-center gap-2 font-mono text-xl font-bold tracking-tighter">
      <span class="text-mint border border-mint/30 px-2 py-1 rounded transition-all group-hover:bg-mint/10 group-hover:shadow-[0_0_15px_rgba(90,214,168,0.3)]">
        MI
      </span>
      <span class="text-slate-50 hidden sm:inline">Mohamed Ismail</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a 
          href={link.href}
          class:list={[
            "relative py-2 text-sm font-medium transition-colors hover:text-mint",
            currentPath.startsWith(link.href) ? "text-mint" : "text-slate-300"
          ]}
        >
          {link.name}
          {currentPath.startsWith(link.href) && (
            <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-mint rounded-full shadow-[0_0_10px_rgba(90,214,168,0.5)]"></span>
          )}
          {!currentPath.startsWith(link.href) && (
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-mint rounded-full transition-all group-hover:w-full"></span>
          )}
        </a>
      ))}
      <a 
        href="/resume.pdf" 
        target="_blank"
        class="px-4 py-2 text-xs font-mono font-bold text-mint border border-mint/30 rounded hover:bg-mint/10 hover:border-mint/50 transition-all"
      >
        RESUME.PDF
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-toggle"
      class="md:hidden text-slate-300 hover:text-mint transition-colors"
      aria-label="Toggle Menu"
    >
      <Menu size={24} />
    </button>
  </div>

  <!-- Mobile Nav Overlay -->
  <div 
    id="mobile-nav" 
    class="fixed inset-0 z-50 bg-slate-950 flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-300 md:hidden"
  >
    <button 
      id="mobile-menu-close"
      class="absolute top-8 right-8 text-slate-300 hover:text-mint transition-colors"
      aria-label="Close Menu"
    >
      <X size={32} />
    </button>
    
    {navLinks.map((link) => (
      <a 
        href={link.href}
        class="text-3xl font-bold text-slate-300 hover:text-mint transition-colors"
      >
        {link.name}
      </a>
    ))}
    <a 
      href="/resume.pdf" 
      class="mt-4 px-8 py-3 text-xl font-mono font-bold text-mint border border-mint/30 rounded hover:bg-mint/10 transition-all"
    >
      RESUME.PDF
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const close = document.getElementById('mobile-menu-close');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    nav?.classList.remove('translate-x-full');
  });

  close?.addEventListener('click', () => {
    nav?.classList.add('translate-x-full');
  });

  // Close nav on link click
  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      nav?.classList.add('translate-x-full');
    });
  });
</script>
