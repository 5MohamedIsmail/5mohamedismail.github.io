---
import { ArrowUpRight } from 'lucide-react';
import SkillBadge from './SkillBadge.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
  featured?: boolean;
}

const { title, description, tags, slug, featured = false } = Astro.props;
---

<a 
  href={`/projects/${slug}`}
  class="group relative block p-[1px] rounded-2xl bg-gradient-to-br from-white/10 to-transparent hover:from-mint/50 transition-all duration-500 overflow-hidden shadow-xl"
>
  <div class="relative h-full bg-slate-900/90 backdrop-blur-xl p-8 rounded-2xl flex flex-col gap-4">
    <div class="flex justify-between items-start">
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <SkillBadge class="text-[10px] py-0 px-2 opacity-80">{tag}</SkillBadge>
        ))}
      </div>
      <div class="text-slate-500 group-hover:text-mint group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300">
        <ArrowUpRight size={24} />
      </div>
    </div>

    <div>
      <h3 class="text-xl font-bold text-slate-50 mb-2 group-hover:text-mint transition-colors">
        {title}
      </h3>
      <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    {featured && (
      <div class="mt-auto pt-4 flex items-center gap-2 font-mono text-[10px] text-mint uppercase tracking-widest font-bold">
        <span class="w-1.5 h-1.5 bg-mint rounded-full animate-pulse"></span>
        Featured Case Study
      </div>
    )}
  </div>

  <!-- Hover Glow Effect -->
  <div class="absolute inset-0 bg-mint/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
</a>
