---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import TechStack from '../components/TechStack.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
---

<BaseLayout>
  <HeroSection />
  
  <TechStack />

  <FeaturedProjects />

  <!-- CTA Section -->
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-mint/5 to-indigo-accent/5"></div>
    <div class="container mx-auto px-6 relative z-10 text-center">
      <div class="glass max-w-4xl mx-auto p-12 rounded-3xl border border-white/10">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-50 mb-6 tracking-tight">
          Ready to secure your <span class="text-mint">infrastructure?</span>
        </h2>
        <p class="text-slate-400 text-lg mb-10 max-w-xl mx-auto">
          Currently open to new opportunities and collaborations in threat detection, SOC engineering, and forensics.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            href="/contact" 
            class="px-8 py-4 bg-mint text-slate-950 font-bold rounded-xl hover:brightness-110 transition-all w-full sm:w-auto"
          >
            Get In Touch
          </a>
          <a 
            href="https://linkedin.com/in/5mohamedismail" 
            target="_blank"
            class="px-8 py-4 glass text-slate-300 font-bold rounded-xl border border-white/10 hover:bg-white/5 transition-all w-full sm:w-auto"
          >
            LinkedIn Profile
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
