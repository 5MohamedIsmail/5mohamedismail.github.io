---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | Blog`} description={post.data.description}>
  <article class="max-w-3xl mx-auto py-20">
    <header class="mb-12">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map(tag => (
          <span class="text-xs font-bold uppercase tracking-wider text-primary">{tag}</span>
        ))}
      </div>
      <h1 class="text-4xl md:text-6xl font-headings text-primary mb-6 leading-tight">
        {post.data.title}
      </h1>
      <div class="flex items-center text-muted text-sm">
        <span>{formattedDate}</span>
        <span class="mx-2">•</span>
        <span>{post.data.description}</span>
      </div>
    </header>

    <div class="prose prose-lg dark:prose-invert prose-primary max-w-none">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-border">
      <a href="/blog" class="text-primary font-medium hover:underline">
        ← Back to blog
      </a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* Custom prose styling */
  .prose h2 {
    @apply font-headings text-3xl mt-12 mb-6;
  }
  .prose h3 {
    @apply font-headings text-2xl mt-8 mb-4;
  }
  .prose p {
    @apply mb-6 leading-relaxed text-muted;
  }
  .prose ul {
    @apply list-disc list-inside mb-6 text-muted;
  }
  .prose li {
    @apply mb-2;
  }
  .prose code {
    @apply bg-primary/10 px-1.5 py-0.5 rounded text-primary text-sm;
  }
  .prose pre {
    @apply bg-bg border border-border p-6 rounded-xl mb-8 overflow-x-auto;
  }
  .prose pre code {
    @apply bg-transparent p-0 text-text;
  }
</style>
