---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog | Mohamed Ismail" description="Insights on cybersecurity, development, and my latest research.">
  <div class="max-w-4xl mx-auto py-20">
    <SectionHeading title="Blog" subtitle="Sharing my thoughts, tutorials, and case studies on security and tech." />
    
    <div class="mt-12">
      {posts.map(post => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          href={`/blog/${post.slug}`}
        />
      ))}
    </div>
  </div>
</BaseLayout>
