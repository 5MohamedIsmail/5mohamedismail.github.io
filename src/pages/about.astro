---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import { getCollection } from 'astro:content';

const experience = await getCollection('experience');
// Optional: sort experience if needed
---

<BaseLayout title="About | Mohamed Ismail" description="Learn more about my background, experience, and education.">
  <div class="max-w-4xl mx-auto py-20">
    <SectionHeading title="About Me" />
    
    <div class="prose prose-lg dark:prose-invert mb-20 text-muted">
      <p>
        Hello! I'm Mohamed Ismail, a Security Engineer with a strong foundation in full-stack development. 
        I bridge the gap between building robust applications and ensuring they are resilient against modern threats.
      </p>
      <p>
        My journey began with web development, where I fell in love with creating interactive experiences. 
        As I delved deeper, I became fascinated by the security aspect of the web, leading me to specialize in 
        cybersecurity, with a focus on incident response, digital forensics, and proactive defense strategies.
      </p>
    </div>

    <SectionHeading title="Work Experience" />
    <Timeline experience={experience.map(e => e.data)} />

    <SectionHeading title="Education" />
    <div class="space-y-8">
      <div class="border-l border-border pl-8 relative">
        <div class="absolute -left-1.5 top-1.5 w-3 h-3 bg-primary rounded-full border-2 border-bg"></div>
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between mb-2">
          <h3 class="text-xl font-headings text-primary">B.Sc. in Computer Science</h3>
          <span class="text-sm text-muted font-medium">2017 — 2021</span>
        </div>
        <div class="text-lg font-medium mb-3">University of Technology</div>
        <p class="text-muted text-sm">Focused on Network Security and Distributed Systems.</p>
      </div>
    </div>
  </div>
</BaseLayout>
