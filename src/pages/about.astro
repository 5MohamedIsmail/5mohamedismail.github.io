---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Mail, Linkedin, Github, Shield, Terminal, Search } from 'lucide-react';

const timeline = [
  {
    date: "2023 - Present",
    title: "Senior Security Analyst",
    company: "SecureOps Systems",
    description: "Leading incident response and threat hunting operations. Implementing automated detection pipelines."
  },
  {
    date: "2021 - 2023",
    title: "SOC Analyst II",
    company: "CyberGuard Solutions",
    description: "Monitored enterprise networks for security breaches. Developed custom SIEM dashboards and alerts."
  },
  {
    date: "2019 - 2021",
    title: "Junior Security Engineer",
    company: "DataShield Inc.",
    description: "Assisted in vulnerability assessments and firewall management. Hardened internal server infrastructure."
  }
];

const certifications = [
  { name: "CompTIA Security+", issuer: "CompTIA", date: "2021" },
  { name: "Certified Ethical Hacker (CEH)", issuer: "EC-Council", date: "2022" },
  { name: "Splunk Core Certified Power User", issuer: "Splunk", date: "2023" }
];
---

<BaseLayout title="About | Mohamed Ismail">
  <section class="py-20">
    <div class="container mx-auto px-6">
      <SectionHeading label="// IDENTITY" title="About Me" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-24">
        <div class="lg:col-span-4">
          <div class="sticky top-32">
            <div class="aspect-square rounded-3xl overflow-hidden glass p-1 mb-8">
              <div class="w-full h-full bg-gradient-to-br from-mint/20 to-indigo-accent/20 flex items-center justify-center text-mint font-black text-9xl tracking-tighter">
                MI
              </div>
            </div>
            
            <div class="flex flex-col gap-4">
              <a href="mailto:contact@mohamedismail.com" class="flex items-center gap-4 text-slate-400 hover:text-mint transition-colors group">
                <div class="w-10 h-10 rounded-lg glass flex items-center justify-center group-hover:border-mint/30">
                  <Mail size={18} />
                </div>
                contact@mohamedismail.com
              </a>
              <a href="https://linkedin.com/in/5mohamedismail" target="_blank" class="flex items-center gap-4 text-slate-400 hover:text-mint transition-colors group">
                <div class="w-10 h-10 rounded-lg glass flex items-center justify-center group-hover:border-mint/30">
                  <Linkedin size={18} />
                </div>
                linkedin.com/in/5mohamedismail
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="prose prose-invert prose-lg max-w-none">
            <p class="text-xl text-slate-200 leading-relaxed">
              I am a dedicated Information Security Analyst with a passion for uncovering hidden threats and building robust defense systems. With over 5 years of experience in the field, I specialize in <span class="text-mint font-bold">detection engineering</span>, <span class="text-mint font-bold">incident response</span>, and <span class="text-mint font-bold">forensic analysis</span>.
            </p>
            <p>
              My journey into cybersecurity began with a deep curiosity about how systems fail and how they can be protected. Today, I spend my time analyzing complex attack patterns, optimizing SIEM platforms, and contributing to the open-source security community.
            </p>
            <p>
              I believe that security is not a destination but a continuous process of learning and adaptation. Whether it's dissecting a new malware sample or hardening a cloud environment, I approach every challenge with a meticulous, data-driven mindset.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-12">
              <div class="p-6 glass rounded-2xl border border-white/5">
                <Shield class="text-mint mb-4" size={32} />
                <h4 class="text-lg font-bold text-slate-50 mb-2">Hardening</h4>
                <p class="text-sm text-slate-400">Securing infrastructure through micro-segmentation and least privilege.</p>
              </div>
              <div class="p-6 glass rounded-2xl border border-white/5">
                <Terminal class="text-mint mb-4" size={32} />
                <h4 class="text-lg font-bold text-slate-50 mb-2">Analysis</h4>
                <p class="text-sm text-slate-400">Deep-dive forensics and traffic analysis to reconstruct incidents.</p>
              </div>
              <div class="p-6 glass rounded-2xl border border-white/5">
                <Search class="text-mint mb-4" size={32} />
                <h4 class="text-lg font-bold text-slate-50 mb-2">Hunting</h4>
                <p class="text-sm text-slate-400">Proactively searching for indicators of compromise and APT activity.</p>
              </div>
            </div>

            <h3 class="text-2xl font-bold text-slate-50 mt-16 mb-8 underline decoration-mint/30 underline-offset-8">Professional Timeline</h3>
            <div class="space-y-12 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-white/10 before:to-transparent">
              {timeline.map((item) => (
                <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
                  <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-slate-950 text-mint shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2">
                    <div class="w-2 h-2 rounded-full bg-current animate-pulse"></div>
                  </div>
                  <div class="w-[calc(100%-4rem)] md:w-[45%] glass p-6 rounded-2xl border border-white/5">
                    <time class="font-mono text-xs font-bold text-mint">{item.date}</time>
                    <h4 class="text-lg font-bold text-slate-50 mt-1">{item.title}</h4>
                    <p class="text-sm text-slate-500 mb-4">{item.company}</p>
                    <p class="text-sm text-slate-400 leading-relaxed">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>

            <h3 class="text-2xl font-bold text-slate-50 mt-20 mb-8 underline decoration-mint/30 underline-offset-8">Certifications</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {certifications.map((cert) => (
                <div class="p-4 glass rounded-xl border border-white/5 flex items-center justify-between">
                  <div>
                    <h5 class="font-bold text-slate-200">{cert.name}</h5>
                    <p class="text-xs text-slate-500">{cert.issuer}</p>
                  </div>
                  <span class="font-mono text-[10px] text-mint">{cert.date}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
