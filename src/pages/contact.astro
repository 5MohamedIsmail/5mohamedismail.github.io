---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Send, MapPin, Mail, Phone, Github, Linkedin, Twitter } from 'lucide-react';

const contactInfo = [
  { icon: Mail, label: 'Email', value: 'contact@mohamedismail.com', href: 'mailto:contact@mohamedismail.com' },
  { icon: MapPin, label: 'Location', value: 'Washington, D.C. (Remote)', href: null },
];

const socials = [
  { icon: Github, label: 'GitHub', href: 'https://github.com/5mohamedismail' },
  { icon: Linkedin, label: 'LinkedIn', href: 'https://linkedin.com/in/5mohamedismail' },
  { icon: Twitter, label: 'Twitter', href: 'https://twitter.com/5mohamedismail' },
];
---

<BaseLayout title="Contact | Mohamed Ismail">
  <section class="py-20 min-h-screen flex items-center">
    <div class="container mx-auto px-6">
      <SectionHeading label="// CONNECT" title="Get In Touch" />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Contact Information -->
        <div>
          <p class="text-xl text-slate-300 mb-12 leading-relaxed">
            Have a project in mind or want to discuss the latest in threat detection? 
            Drop me a message and let's secure the future together.
          </p>

          <div class="space-y-8 mb-16">
            {contactInfo.map((info) => (
              <div class="flex items-center gap-6 group">
                <div class="w-14 h-14 rounded-2xl glass flex items-center justify-center text-mint group-hover:shadow-[0_0_20px_rgba(90,214,168,0.2)] transition-all">
                  <info.icon size={24} />
                </div>
                <div>
                  <p class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-1">{info.label}</p>
                  {info.href ? (
                    <a href={info.href} class="text-lg font-bold text-slate-100 hover:text-mint transition-colors">
                      {info.value}
                    </a>
                  ) : (
                    <p class="text-lg font-bold text-slate-100">{info.value}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <div>
            <p class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-6">FOLLOW_ON_SOCIALS</p>
            <div class="flex gap-4">
              {socials.map((social) => (
                <a 
                  href={social.href} 
                  target="_blank"
                  class="w-12 h-12 rounded-xl glass flex items-center justify-center text-slate-400 hover:text-mint hover:border-mint/30 transition-all hover:-translate-y-1"
                  aria-label={social.label}
                >
                  <social.icon size={20} />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="glass p-8 md:p-12 rounded-3xl border border-white/10 relative overflow-hidden">
          <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
            <Send size={120} class="text-mint" />
          </div>

          <form action="#" method="POST" class="relative z-10 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="text-xs font-mono text-slate-400 uppercase tracking-widest">NAME.exe</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required
                  placeholder="John Doe"
                  class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-5 py-4 text-slate-100 focus:outline-none focus:border-mint/50 transition-colors placeholder:text-slate-700"
                />
              </div>
              <div class="space-y-2">
                <label for="email" class="text-xs font-mono text-slate-400 uppercase tracking-widest">EMAIL_ADDR</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  placeholder="john@example.com"
                  class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-5 py-4 text-slate-100 focus:outline-none focus:border-mint/50 transition-colors placeholder:text-slate-700"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label for="subject" class="text-xs font-mono text-slate-400 uppercase tracking-widest">SUBJECT_LINE</label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                required
                placeholder="Inquiry regarding threat detection services"
                class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-5 py-4 text-slate-100 focus:outline-none focus:border-mint/50 transition-colors placeholder:text-slate-700"
              />
            </div>

            <div class="space-y-2">
              <label for="message" class="text-xs font-mono text-slate-400 uppercase tracking-widest">MESSAGE_BODY</label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                placeholder="How can I help you secure your network?"
                class="w-full bg-slate-950/50 border border-white/10 rounded-xl px-5 py-4 text-slate-100 focus:outline-none focus:border-mint/50 transition-colors placeholder:text-slate-700 resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full bg-mint text-slate-950 font-bold py-4 rounded-xl hover:brightness-110 hover:shadow-[0_0_20px_rgba(90,214,168,0.3)] transition-all flex items-center justify-center gap-2 group"
            >
              TRANSMIT_MESSAGE
              <Send size={18} class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
