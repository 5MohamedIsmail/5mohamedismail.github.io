---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteData } from '../data/site';
---

<BaseLayout title="Contact | Mohamed Ismail" description="Get in touch with me for projects, research, or opportunities.">
  <div class="max-w-4xl mx-auto py-20">
    <SectionHeading title="Get In Touch" subtitle="I'm always open to new opportunities and collaborations." />
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
      <div class="space-y-8">
        <p class="text-lg text-muted leading-relaxed">
          Whether you have a question, a project proposal, or just want to say hi, 
          feel free to reach out through any of the following channels.
        </p>
        
        <div class="space-y-4">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="text-sm text-muted">Email</div>
              <a href={siteData.social.email} class="text-lg font-medium hover:text-primary transition-colors">
                {siteData.social.email.replace('mailto:', '')}
              </a>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center text-primary">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </div>
            <div>
              <div class="text-sm text-muted">LinkedIn</div>
              <a href={siteData.social.linkedin} class="text-lg font-medium hover:text-primary transition-colors" target="_blank">
                In/5mohamedismail
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-primary/5 p-8 rounded-3xl border border-primary/10">
        <form class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-muted mb-2">Name</label>
            <input type="text" id="name" name="name" class="w-full bg-bg border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" placeholder="Your Name" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-muted mb-2">Email</label>
            <input type="email" id="email" name="email" class="w-full bg-bg border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" placeholder="your@email.com" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-muted mb-2">Message</label>
            <textarea id="message" name="message" rows="4" class="w-full bg-bg border border-border rounded-xl px-4 py-3 focus:outline-none focus:border-primary transition-colors" placeholder="How can I help you?"></textarea>
          </div>
          <button type="submit" class="w-full bg-primary text-primary-foreground font-bold py-4 rounded-xl hover:opacity-90 transition-opacity">
            Send Message
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
