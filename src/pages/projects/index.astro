---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects | Mohamed Ismail" description="Explore my portfolio of security tools, web applications, and research projects.">
  <div class="py-20">
    <SectionHeading title="All Projects" subtitle="A comprehensive list of my professional and personal projects." />
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map(project => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
          github={project.data.github}
          demo={project.data.demo}
          href={`/projects/${project.slug}`}
        />
      ))}
    </div>
  </div>
</BaseLayout>
